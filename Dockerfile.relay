FROM node:22-slim

RUN apt-get update && apt-get install -y curl ca-certificates && rm -rf /var/lib/apt/lists/*

# Claude CLI (needed by claude-relay)
RUN npm install -g @anthropic-ai/claude-code

# uv (for uvx claude-relay)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

EXPOSE 8082
# Install claude-relay from git (includes stdin piping fix for large prompts)
RUN uv pip install --system "claude-relay @ git+https://github.com/npow/claude-relay.git@main"
CMD ["claude-relay", "serve", "--host", "0.0.0.0"]

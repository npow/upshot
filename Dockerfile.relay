FROM node:22-slim

RUN apt-get update && apt-get install -y curl ca-certificates && rm -rf /var/lib/apt/lists/*

# Claude CLI (needed by claude-relay)
RUN npm install -g @anthropic-ai/claude-code

# uv (for uvx claude-relay)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

EXPOSE 8082
# Pre-install claude-relay at build time (avoids uvx cache staleness)
RUN uvx --reinstall claude-relay --help > /dev/null 2>&1 || true
CMD ["uvx", "claude-relay", "serve", "--host", "0.0.0.0"]
